name: 🐙 章鱼AI · 手动抓取推送

on:
  workflow_dispatch:
    inputs:
      no_push:
        description: "仅生成日报，不推送到微信"
        type: boolean
        default: false
        required: false
      force_push:
        description: "内容非当天也强制推送（谨慎；默认当天检验通过才推送）"
        type: boolean
        default: false
        required: false

jobs:
  octopus-manual-push:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: write

    steps:
      - name: 📥 检出仓库
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: 🐍 配置 Python 环境
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: 📦 安装依赖
        run: |
          set -euo pipefail
          python -m pip install --upgrade pip --quiet
          pip install --quiet requests

      - name: 🐙 抓取最新动态数据并推送（手动）
        env:
          PUSHPLUS_TOKEN: ${{ secrets.PUSHPLUS_TOKEN }}
          # 一对多群组推送（2026-10-23 起默认）：群组编码优先取 Secret PUSHPLUS_TOPIC；
          # Secret 没配时兜底用仓库群组 oai.1（下面这个字面量就是兜底值，换群改这里）。
          PUSHPLUS_TOPIC: ${{ secrets.PUSHPLUS_TOPIC || 'oai.1' }}
          # 推送模式：one2many（默认，一对多群组）/ one2one（一对一 直发自己）。
          PUSHPLUS_MODE: ${{ vars.PUSHPLUS_MODE || 'one2many' }}
          # AI 七日港股走势分析概率的大模型 Key（OpenAI 兼容；未配置按 OCTOPUS_HK7_FALLBACK 口径处理）
          # 按原名透传，由 hk_seven_day.py 做「本仓专用名 → 厂商通用名」回落：
          # 仓库里既有的 DEEPSEEK_API_KEY 不必改名换值，配好就能用。
          OCTOPUS_LLM_API_KEY: ${{ secrets.OCTOPUS_LLM_API_KEY }}
          DEEPSEEK_API_KEY: ${{ secrets.DEEPSEEK_API_KEY }}
          OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
          OCTOPUS_LLM_BASE_URL: ${{ vars.OCTOPUS_LLM_BASE_URL }}
          OCTOPUS_LLM_MODEL: ${{ vars.OCTOPUS_LLM_MODEL }}
          OCTOPUS_LLM_MAX_TOKENS: ${{ vars.OCTOPUS_LLM_MAX_TOKENS }}
        run: |
          set -euo pipefail
          NO_PUSH="${{ github.event.inputs.no_push || 'false' }}"
          FORCE_PUSH="${{ github.event.inputs.force_push || 'false' }}"

          EXTRA_ARGS=""
          if [ "$FORCE_PUSH" = "true" ]; then
            EXTRA_ARGS="--force-push"
            echo "运行模式：手动强制推送（当天检验未通过也推送）"
          else
            echo "运行模式：手动推送（当天内容检验通过才推送）"
          fi

          if [ "$NO_PUSH" = "true" ]; then
            echo "运行模式：仅生成，不推送"
            python3 output/pipeline.py --manual --no-push
          else
            echo "运行模式：抓取最新数据 → 生成 → 当天检验 → 推送"
            python3 output/pipeline.py --manual ${EXTRA_ARGS}
          fi

      - name: 📤 提交生成的日报
        if: always()
        run: |
          set -euo pipefail
          git config user.name "octopus-bot"
          git config user.email "bot@octopus.ai"

          git add output/daily_report_*.html output/latest.html output/hk7_forecast.json 2>/dev/null || true

          if git diff --cached --quiet; then
            echo "无新内容，跳过提交。"
          else
            COMMIT_DATE=$(TZ='Asia/Macau' date +%Y-%m-%d)
            git commit -m "📰 手动抓取推送 ${COMMIT_DATE}"
            git push origin HEAD
          fi
